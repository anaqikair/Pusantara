<?xml version="1.0"?>
<robot name="pusantara" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================= -->
  <!-- Basic colors              -->
  <!-- ========================= -->

  <material name="black">
    <color rgba="0.02 0.02 0.02 1"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.15 0.15 0.15 1"/>
  </material>

  <material name="gray">
    <color rgba="0.45 0.45 0.45 1"/>
  </material>

  <material name="silver">
    <color rgba="0.75 0.75 0.75 1"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.25 0.9 1"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.25 1"/>
  </material>

  <material name="red">
    <color rgba="0.9 0.05 0.05 1"/>
  </material>

  <material name="white">
    <color rgba="0.95 0.95 0.95 1"/>
  </material>

  <!-- ========================= -->
  <!-- Base footprint            -->
  <!-- ========================= -->

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Main robot base           -->
  <!-- ========================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.36 0.16"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.36 0.16"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.15" ixy="0.0" ixz="0.0"
               iyy="0.20" iyz="0.0"
               izz="0.25"/>
    </inertial>
  </link>

  <!-- Front direction marker -->
  <link name="front_marker">
    <visual>
      <origin xyz="0.27 0 0.18" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.04"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="front_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_marker"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Wheels                    -->
  <!-- ========================= -->

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.19 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.19 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Caster wheels             -->
  <!-- ========================= -->

  <link name="front_caster">
    <visual>
      <origin xyz="0.19 0 0.025" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster">
    <visual>
      <origin xyz="-0.19 0 0.025" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Upper body / screen       -->
  <!-- ========================= -->

  <link name="screen_pole">
    <visual>
      <origin xyz="0 0 0.38" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.45"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="screen_pole_joint" type="fixed">
    <parent link="base_link"/>
    <child link="screen_pole"/>
    <origin xyz="-0.05 0 0" rpy="0 0 0"/>
  </joint>

  <link name="screen_link">
    <visual>
      <origin xyz="0 0 0.62" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.03 0.22"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="screen_joint" type="fixed">
    <parent link="base_link"/>
    <child link="screen_link"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Simple white screen face -->
  <link name="screen_display">
    <visual>
      <origin xyz="0.19 0 0.62" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.28 0.16"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="screen_display_joint" type="fixed">
    <parent link="base_link"/>
    <child link="screen_display"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- LiDAR                     -->
  <!-- Your current TF uses:
       base_link -> laser
       x=0.135, y=0, z=0.60
       yaw=0
  ========================= -->

  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.055" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.135 0 0.60" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- IMU                       -->
  <!-- ========================= -->

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.015"/>
      </geometry>
      <material name="red"/>
    </visual>

    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Camera                    -->
  <!-- ========================= -->

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.04 0.035"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.22 0 0.58" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.035 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

</robot>
